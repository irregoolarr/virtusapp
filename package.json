{
  "name": "virtusapp",
  "version": "1.0.0",
  "private": true,
  "description": "VirtusMS - Management Service Team Operations Platform",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
