DATABASE_URL="postgresql://virtus:virtus_dev_pass@localhost:5432/virtusapp"
SESSION_SECRET="virtusms-dev-session-secret-change-in-production"
# Self-hosted over plain HTTP only: set to "false" so browsers keep the session cookie.
# Leave unset on Vercel / HTTPS (defaults to Secure in production).
COOKIE_SECURE=""

# Optional SMTP settings (also configurable inside Settings UI)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="VirtusMS Alerts <alerts@virtusms.local>"

# Vercel / hosted deployments
# Secret for /api/cron/events (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""

# First Super Admin created by `pnpm db:seed` / `pnpm db:reset` (database starts empty)
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Test suite logs in with the bootstrap admin
TEST_ADMIN_EMAIL=""
TEST_ADMIN_PASSWORD=""

# Optional: store attachments in Google Drive (README → Attachments & Google Drive)
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""
